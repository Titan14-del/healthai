# Required: Anthropic API key for Claude model access
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Required: PostgreSQL connection string (Supabase or other)
# Supabase Session Pooler format: postgres://postgres.[project-ref].[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres.[project-ref].[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Required: Secret key for JWT token signing (use a random string)
SECRET_KEY=your-random-secret-key-here

# Optional: Access token lifetime in minutes (default 60)
TOKEN_EXPIRE_MINUTES=60

# Required: Comma-separated list of allowed frontend origins (no trailing slash)
# Example for Render: https://healthai.onrender.com
ALLOWED_ORIGINS=https://your-app.onrender.com

# Required for password reset emails: SendGrid API key
SENDGRID_API_KEY=SG.your-sendgrid-api-key
